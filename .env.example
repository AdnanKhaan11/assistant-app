# ---------- LLM ----------
# provider: openai | groq | gemini | anthropic | ollama | openrouter | deepseek
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b  # current Groq default; override with a model supported by your provider
LLM_API_KEY=                    # or use the provider-specific variable below
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ---------- Assistant ----------
MEMORY_WINDOW_TURNS=10
DB_PATH=data/assistant.db
TICKETS_PATH=data/sample_tickets.json

# ---------- Troubleshooting knowledge base ----------
KNOWLEDGE_PDF_PATH=data/uploads/IT_Troubleshooting_Playbook.pdf
HF_TOKEN=                         # Hugging Face token with Inference Providers permission
HF_EMBEDDING_MODEL=thenlper/gte-large
HF_EMBEDDING_URL=https://router.huggingface.co/hf-inference/models
QDRANT_URL=                       # Qdrant endpoint, e.g. http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=troubleshooting_knowledge

# ---------- Telemetry ----------
TELEMETRY_ENABLED=true
TELEMETRY_EXPORTER=otlp         # otlp | console | none
OTEL_SERVICE_NAME=assistant-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SERVICE_VERSION=0.1.0
DEPLOYMENT_ENV=development
TELEMETRY_SAMPLE_RATIO=1.0
TELEMETRY_CAPTURE_CONTENT=false  # keep false in production (prompts may contain personal data)
LOG_LEVEL=INFO
LOG_FORMAT=json                 # json | text
